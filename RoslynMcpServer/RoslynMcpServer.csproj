<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Roslyn 5.x (C# 14) ships Workspaces.MSBuild for net10.0 only -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Run on a newer runtime (.NET 11) when .NET 10 is not installed -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RoslynMcpServer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- MCP Server SDK -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="ModelContextProtocol" Version="0.3.0-preview.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    
    <!-- Roslyn packages. Workspaces.MSBuild evaluates projects in a separate BuildHost process that
         finds a matching .NET SDK itself, so no MSBuildLocator is needed and projects targeting a newer
         .NET than the server's runtime (net11.0) still get their references; 5.x parses C# 14. -->
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    
    <!-- Additional utilities -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.14" />
  </ItemGroup>

</Project>
